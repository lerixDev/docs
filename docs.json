{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Atelerix Docs",
  "colors": {
    "primary": "#64523C",
    "light": "#997668",
    "dark": "#8F7656"
  },
  "fonts": {
    "family": "Alexandria"
  },
  "favicon": "/atelerix-icon.svg",
  "navigation": {
  
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://docs.atelerix.com",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Dashboard",
          "href": "https://app.atelerix.com",
          "icon": "gauge"
        }
       
      ]
    },

    "languages": [
      {
        "language": "en",
        "pages": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "dashboard"
            ]
          },
          {
            "group": "Frameworks",
            "icon": "code",
            "pages": [
              {
                "group": "Flutter SDK",
                "icon": "flutter",
                "pages": [
                  "frameworks/flutter/installation",
                  "frameworks/flutter/push-notifications",
                  "frameworks/flutter/error-tracking"
                ]
              }
            ]
          },
          {
            "group": "Modules",
            "icon": "rocket",
            "pages": [ 
              "modules/error-tracking",
              "modules/push-notifications",
              "modules/analytics",
              "modules/in-app-messages",
              "modules/feedback",
              "modules/updates"
            ]
          },

          {
            "group": "Developers",
            "icon": "laptop-code",
            "pages": [
              {
                "group": "API Reference",
                "icon": "code",
                "pages": [
                  "api-reference/introductaion",
                  {
                    "group": "Push Notifications",
                    "pages": [
                      "api-reference/push-notifications",
                      "api-reference/update-notification",
                      "api-reference/unsend-notification",
                      "api-reference/cancel-notification",
                      "api-reference/notification-deliveries"
                    ]
                  }
                ]
              },
              {
                "group": "Error/Success Codes",
                "icon": "hashtag",
                "pages": [
                  "developers/errors-responses"
                ]
              }
            ]
          }
         
        ]
      },
      {
        "language": "ar",
        "pages": [
          {
            "group": "البدء",
            "pages": [
              "ar/index",
              "ar/quickstart",
              "ar/dashboard"
            ]
          },
          {
            "group": "أطر العمل",
            "icon": "code",
            "pages": [
              {
                "group": "Flutter SDK",
                "icon": "flutter",
                "pages": [
                  "ar/frameworks/flutter/installation",
                  "ar/frameworks/flutter/push-notifications",
                  "ar/frameworks/flutter/error-tracking"
                ]
              }
            ]
          },
          {
            "group": "الوحدات",
            "icon": "rocket",
            "pages": [
              "ar/modules/error-tracking",
              "ar/modules/push-notifications",
              "ar/modules/analytics",
              "ar/modules/in-app-messages",
              "ar/modules/feedback",
              "ar/modules/updates"
            ]
          },
          {
            "group": "المطورون",
            "icon": "laptop-code",
            "pages": [
              {
                "group": "مرجع API",
                "icon": "code",
                "pages": [
                  "ar/api-reference/introductaion",
                  {
                    "group": "الإشعارات",
                    "pages": [
                      "ar/api-reference/push-notifications",
                      "ar/api-reference/update-notification",
                      "ar/api-reference/unsend-notification",
                      "ar/api-reference/cancel-notification",
                      "ar/api-reference/notification-deliveries"
                    ]
                  }
                ]
              },
              {
                "group": "رموز الأخطاء والنجاح",
                "icon": "hashtag",
                "pages": [
                  "ar/developers/errors-responses"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@atelerix.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.atelerix.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "mdx": {
      "server": "https://api.atelerix.dev/v1",
      "auth": {
        "method": "key",
        "name": "atelerix-api-key"
      }
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/atelerixDev",
      "github": "https://github.com/AtelerixDev",
      "linkedin": "https://linkedin.com/company/AtelerixDev"
    }
  }
}