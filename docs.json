  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://lerix.dev"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://lerix.dev"
      },
      {
        "label": "Support",
        "href": "mailto:support@lerix.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://app.lerix.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "mdx": {
      "server": "https://api.lerix.dev/v1",
      "auth": {
        "method": "key",
        "name": "lerix-key"
      }
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/lerixdev",
      "github": "https://github.com/lerixDev",
      "instagram": "https://instagram.com/lerix.dev"
    }
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0e0f11"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "styling": {
    "codeblocks": "dark"
  },
  "description": "Lerix: crash reporting, AI debugging and push notifications for Flutter, iOS, Android, React, Next.js, Angular and the web.",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Lerix Docs",
      "twitter:site": "@lerixdev"
    }
  },
  "redirects": [
    {
      "source": "/api-reference/introductaion",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/ar/api-reference/introductaion",
      "destination": "/ar/api-reference/introduction"
    }
  ]
